{
  "name": "qpet-games-web",
  "private": true,
  "type": "module",
  "description": "Q宠游戏：八款独立 HTML / Canvas / JavaScript 游戏",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "python3 scripts/verify.py",
    "start": "python3 scripts/serve.py",
    "build:native": "node scripts/build-native.mjs",
    "build:magpie": "node scripts/build-native.mjs --game=magpie-bridge",
    "build:racing": "node scripts/build-native.mjs --game=qpet-racing",
    "test": "node --test native/*/tests/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
